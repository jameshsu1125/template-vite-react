BUNNY_STORAGE_PASSWORD=
BUNNY_SFTP_HOST=storage.bunnycdn.com
# 清除 CDN 快取用：Bunny 帳號的 API key（Account settings → API key），不是儲存區域密碼
BUNNY_API_KEY=

